{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iwara-web",
  "main": "src/index.js",
  "compatibility_date": "2026-03-08",
  "compatibility_flags": ["nodejs_compat"],

  // 只有接口与媒体走 Worker，静态资源由 Cloudflare 直接回源，不消耗 Worker 请求数。
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // 站点访问密码要求**任何**请求都先经过 Worker：
    // 否则 Assets 的 SPA 回退会把 index.html 直接吐给未知路径的访客
    // （例如 /video/xxx），密码就只挡得住数据、挡不住页面外壳。
    // 代价是静态资源也各消耗一次 Worker 请求，换来的是密码真正有效。
    "run_worker_first": true
  },

  // 保留 workers.dev 域名（自定义域名仍然优先）；关闭预览 URL，
  // 避免同一份代码被多个随机子域访问到。
  "workers_dev": true,
  "preview_urls": false,

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },

  "vars": {
    // 站点名称，显示在标题与页头。
    "SITE_NAME": "Iwara 映像",
    // 默认内容来源站点：main = www.iwara.tv，ai = www.iwara.ai
    "DEFAULT_SITE": "main",
    // 站点访问密码请用 secret 配置（不能和 vars 同名，否则会冲突）：
    //   wrangler secret put SITE_PASSWORD
    // 全站 Basic Auth 保护，设置后整个站点（含接口与媒体）都需要登录才能访问。
    // 公开部署强烈建议开启，避免额度被陌生人消耗。用 wrangler secret put 配置更安全。
    "BASIC_AUTH_USER": "",
    "BASIC_AUTH_PASS": "",
    // 访客共享 Token 用 secret 配置（不能与 vars 同名，否则会冲突）：
    //   wrangler secret put IWARA_AUTHORIZATION
    // 上游接口缓存秒数，用于节省 Worker 请求数。设为 0 关闭。
    "API_CACHE_TTL": "30",
    // 封面图缓存秒数。
    "IMAGE_CACHE_TTL": "604800"
  }
}
