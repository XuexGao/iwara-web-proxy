{
  "name": "iwara-web-proxy",
  "version": "1.0.0",
  "private": true,
  "description": "在 Cloudflare Workers 上运行的 Iwara 网页版：API / 视频 / 图片全量反代，支持登录、搜索、播放与收藏。",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "secret": "wrangler secret put SESSION_SECRET",
    "test": "node test/backend.test.mjs",
    "test:gate": "node test/gate.test.mjs",
    "test:player": "node test/player-gestures.test.mjs",
    "test:theme": "node test/theme.test.mjs",
    "shots": "node tools/shot.mjs",
    "test:ui": "node test/frontend.smoke.mjs",
    "test:routes": "node test/routes.smoke.mjs",
    "check": "node tools/check-imports.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.126.0"
  }
}
